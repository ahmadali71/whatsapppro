# =============================================
# APPLICATION
# =============================================
NODE_ENV=development
PORT=3001
FRONTEND_URL=https://whatsapppro-web.vercel.app
CORS_ORIGINS=https://whatsapppro-web.vercel.app,https://web-9b56.vercel.app,http://localhost:3000,http://localhost:3001

# =============================================
# DATABASE
# =============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_pro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# =============================================
# REDIS
# =============================================
REDIS_URL=redis://:redis@localhost:6379
REDIS_PASSWORD=redis

# =============================================
# JWT AUTHENTICATION
# =============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# =============================================
# AWS S3 (Media Storage)
# =============================================
AWS_S3_BUCKET=whatsapp-pro-media
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# =============================================
# TWILIO (SMS / Phone Verification)
# =============================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================
# FIREBASE (Push Notifications)
# =============================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# =============================================
# WEBRTC / TURN SERVER (Calls)
# =============================================
WEBRTC_TURN_SERVER_URL=turn:your-turn-server.example.com:3478
WEBRTC_TURN_USERNAME=your-turn-username
WEBRTC_TURN_CREDENTIAL=your-turn-credential
